# Copy to .env and fill in. Restart the server after changes.
BASE_URL=http://localhost:3000
# NODE_ENV=production

# ---- Email (pick one provider: resend | brevo | sendgrid) ----
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=Cap Orientation <no-reply@your-domain.com>

# ---- External login (any OpenID Connect provider) ----
# Google:  OIDC_ISSUER=https://accounts.google.com
# Auth0:   OIDC_ISSUER=https://YOUR-TENANT.eu.auth0.com/
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=Google
